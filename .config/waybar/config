{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 4,

  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "cpu",
    "memory",
    "bluetooth",
    "network",
    "pulseaudio",
    "battery",
    "group/tray",
    "custom/notification",
    "custom/power"
  ],

  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "all-outputs": false,
    "format-icons": {
      "default": "",
      "urgent": ""
    },
    "persistent-workspaces": {
      "HDMI-A-1": [1, 2, 3, 4, 5],
      "eDP-1": [6, 7, 8, 9, 10]
    }
  },

  "hyprland/window": {
    "format": "{class}",
    "max-length": 40,
    "rewrite": {
      "": "Desktop"
    }
  },

  "clock": {
    "format": "{:L%B | %a %d, %Y | %I:%M %p}",
    "format-alt": "{:L%a %b %d, %G}",
    "tooltip": false
  },

  "cpu": {
    "format": "  {usage}%",
    "interval": 2,
    "tooltip-format": "CPU Usage: {usage}%"
  },

  "memory": {
    "format": "  {percentage}%",
    "interval": 2,
    "tooltip-format": "Memory: {used:0.1f}GiB / {total:0.1f}GiB\nSwap: {swapUsed:0.1f}GiB / {swapTotal:0.1f}GiB"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": "󰂱 {device_alias}",
    "tooltip-format": "{controller_alias}\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "blueman-manager"
  },
  
  "network": {
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format": "{essid} ({signalStrength}%)",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "on-click": "nm-connection-editor"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Muted",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "default": ["", "", " "]
    },
    "scroll-step": 2,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "battery": {
    "states": {
      "warning": 20,
      "critical": 10
    },
    "tooltip": false,
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },

  "group/tray": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "children-class": "hidden",
      "transition-left-to-right": false,
      "click-to-reveal": true
    },
    "modules": [
      "custom/system_tray",
      "custom/separator",
      "tray"
    ]
  },

  "custom/system_tray": {
    "format": "",
    "tooltip": false
  },

  "custom/separator": {
    "format": "|",
    "tooltip": false
  },

  "tray": {
    "icon-size": 14,
    "spacing": 8,
    "show-passive-items": true
  },

  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": " <span foreground='#f07178'><sup></sup></span>",
      "none": " ",
      "dnd-notification": " <span foreground='#f07178'><sup></sup></span>",
      "dnd-none": " ",
      "inhibited-notification": " <span foreground='#f07178'><sup></sup></span>",
      "inhibited-none": " ",
      "dnd-inhibited-notification": " <span foreground='#f07178'><sup></sup></span>",
      "dnd-inhibited-none": " "
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "custom/power": {
    "format": " ",
    "tooltip": false,
    "on-click": "wlogout -n"
  }
}
